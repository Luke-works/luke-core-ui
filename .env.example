# Copy to .env.local for local dev (gitignored), or set these in Render.
#
# Vite inlines VITE_* variables at BUILD time — they are not read at runtime.

# --- Production / static build ---
# Public URL of the deployed luke-core-engine (no trailing slash).
# The axios client (src/shared/api/client.ts) uses this as its baseURL.
# Leave empty for local dev so requests stay same-origin and hit the Vite proxy.
VITE_API_BASE_URL=

# --- Local dev only ---
# Target the Vite dev/preview proxy forwards /engine-rest and /api to.
# Defaults to http://localhost:8080 (see vite.config.ts) if unset.
VITE_CAMUNDA_BASE_URL=http://localhost:8080
